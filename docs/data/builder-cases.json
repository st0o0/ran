{
  "cases": [
    {
      "id": "ok-minimal",
      "env": {
        "RAN_TRAPS": "ssh"
      },
      "expect": "ok"
    },
    {
      "id": "ok-proxy-list-trusted",
      "env": {
        "RAN_PROXY_PROTOCOL": "http",
        "RAN_PROXY_TRUSTED": "127.0.0.1,::1",
        "RAN_TRAPS": "ssh,http"
      },
      "expect": "ok"
    },
    {
      "id": "ok-proxy-on-trusted-any",
      "env": {
        "RAN_PROXY_PROTOCOL": "on",
        "RAN_PROXY_TRUSTED": "any",
        "RAN_TRAPS": "ssh,http"
      },
      "expect": "ok"
    },
    {
      "id": "ok-udp-trap-without-proxy",
      "env": {
        "RAN_PROXY_PROTOCOL": "http",
        "RAN_PROXY_TRUSTED": "127.0.0.1",
        "RAN_TRAPS": "dns,http"
      },
      "expect": "ok"
    },
    {
      "id": "ok-udp-burst-equals-rate",
      "env": {
        "RAN_TRAPS": "dns",
        "RAN_UDP_RATE_BURST": "20",
        "RAN_UDP_RATE_PER_SOURCE": "20"
      },
      "expect": "ok"
    },
    {
      "id": "ok-catchall-with-addr",
      "env": {
        "RAN_CATCHALL_ADDR": ":4444",
        "RAN_TRAPS": "catchall"
      },
      "expect": "ok"
    },
    {
      "id": "error-proxy-on-without-trusted",
      "env": {
        "RAN_PROXY_PROTOCOL": "on",
        "RAN_TRAPS": "ssh"
      },
      "expect": "error",
      "message_contains": "RAN_PROXY_TRUSTED"
    },
    {
      "id": "error-proxy-list-without-trusted",
      "env": {
        "RAN_PROXY_PROTOCOL": "http",
        "RAN_TRAPS": "http"
      },
      "expect": "error",
      "message_contains": "RAN_PROXY_TRUSTED"
    },
    {
      "id": "error-udp-trap-in-proxy-list",
      "env": {
        "RAN_PROXY_PROTOCOL": "dns",
        "RAN_PROXY_TRUSTED": "127.0.0.1",
        "RAN_TRAPS": "ssh,dns"
      },
      "expect": "error",
      "message_contains": "UDP trap"
    },
    {
      "id": "error-unknown-trap-in-proxy-list",
      "env": {
        "RAN_PROXY_PROTOCOL": "bogus",
        "RAN_PROXY_TRUSTED": "127.0.0.1",
        "RAN_TRAPS": "ssh"
      },
      "expect": "error",
      "message_contains": "unknown trap"
    },
    {
      "id": "warning-proxy-trap-not-enabled",
      "env": {
        "RAN_PROXY_PROTOCOL": "http",
        "RAN_PROXY_TRUSTED": "127.0.0.1",
        "RAN_TRAPS": "ssh"
      },
      "expect": "warning",
      "message_contains": "http"
    },
    {
      "id": "warning-trusted-without-proxy",
      "env": {
        "RAN_PROXY_TRUSTED": "127.0.0.1",
        "RAN_TRAPS": "ssh"
      },
      "expect": "warning",
      "message_contains": "RAN_PROXY_TRUSTED"
    },
    {
      "id": "error-udp-burst-below-rate",
      "env": {
        "RAN_TRAPS": "dns",
        "RAN_UDP_RATE_BURST": "10",
        "RAN_UDP_RATE_PER_SOURCE": "20"
      },
      "expect": "error",
      "message_contains": "RAN_UDP_RATE_BURST"
    },
    {
      "id": "error-unknown-trap",
      "env": {
        "RAN_TRAPS": "ssh,bogus"
      },
      "expect": "error",
      "message_contains": "unknown trap"
    },
    {
      "id": "error-port-conflict",
      "env": {
        "RAN_HTTP_ADDR": ":2222",
        "RAN_TRAPS": "ssh,http"
      },
      "expect": "error",
      "message_contains": "both listen"
    },
    {
      "id": "error-port-conflict-banner",
      "env": {
        "RAN_BANNER_SERVICES": "2222=custom:hello",
        "RAN_TRAPS": "ssh,banner"
      },
      "expect": "error",
      "message_contains": "both listen"
    },
    {
      "id": "ok-same-port-tcp-and-udp",
      "env": {
        "RAN_CATCHALL_ADDR": ":53",
        "RAN_TRAPS": "dns,catchall"
      },
      "expect": "ok"
    },
    {
      "id": "error-no-trap",
      "env": {},
      "expect": "error",
      "message_contains": "at least one trap"
    },
    {
      "id": "error-catchall-without-addr",
      "env": {
        "RAN_TRAPS": "catchall"
      },
      "expect": "error",
      "message_contains": "RAN_CATCHALL_ADDR"
    },
    {
      "id": "error-crowdsec-without-url",
      "env": {
        "RAN_CROWDSEC": "on",
        "RAN_TRAPS": "ssh"
      },
      "expect": "error",
      "message_contains": "RAN_CROWDSEC_URL"
    },
    {
      "id": "ok-repeat-cooldown-above-alert",
      "env": {
        "RAN_REPEAT_COOLDOWN": "12h",
        "RAN_TRAPS": "ssh"
      },
      "expect": "ok"
    },
    {
      "id": "ok-shun-with-cooldown",
      "env": {
        "RAN_CROWDSEC": "on",
        "RAN_CROWDSEC_MACHINE_ID": "ran",
        "RAN_CROWDSEC_PASSWORD": "x",
        "RAN_CROWDSEC_URL": "http://localhost:8080",
        "RAN_SHUN": "on",
        "RAN_TRAPS": "ssh"
      },
      "expect": "ok"
    },
    {
      "id": "warning-shun-without-crowdsec",
      "env": {
        "RAN_SHUN": "on",
        "RAN_TRAPS": "ssh"
      },
      "expect": "warning",
      "message_contains": "has no effect without RAN_CROWDSEC"
    },
    {
      "id": "ok-repeat-cooldown-at-max",
      "env": {
        "RAN_REPEAT_COOLDOWN": "8760h",
        "RAN_TRAPS": "ssh"
      },
      "expect": "ok"
    },
    {
      "id": "ok-alert-cooldown-at-max",
      "env": {
        "RAN_ALERT_COOLDOWN": "8760h",
        "RAN_TRAPS": "ssh"
      },
      "expect": "ok"
    },
    {
      "id": "error-repeat-cooldown-too-long",
      "env": {
        "RAN_REPEAT_COOLDOWN": "8761h",
        "RAN_TRAPS": "ssh"
      },
      "expect": "error",
      "message_contains": "RAN_REPEAT_COOLDOWN"
    },
    {
      "id": "error-alert-cooldown-too-long",
      "env": {
        "RAN_ALERT_COOLDOWN": "2562047h",
        "RAN_TRAPS": "ssh"
      },
      "expect": "error",
      "message_contains": "RAN_ALERT_COOLDOWN"
    },
    {
      "id": "warning-shun-without-alert-cooldown",
      "env": {
        "RAN_ALERT_COOLDOWN": "0s",
        "RAN_SHUN": "on",
        "RAN_TRAPS": "ssh"
      },
      "expect": "warning",
      "message_contains": "RAN_SHUN has no effect"
    },
    {
      "id": "warning-repeat-cooldown-without-alert-cooldown",
      "env": {
        "RAN_ALERT_COOLDOWN": "0s",
        "RAN_REPEAT_COOLDOWN": "12h",
        "RAN_TRAPS": "ssh"
      },
      "expect": "warning",
      "message_contains": "RAN_REPEAT_COOLDOWN has no effect"
    },
    {
      "id": "warning-repeat-cooldown-below-alert-cooldown",
      "env": {
        "RAN_REPEAT_COOLDOWN": "30m",
        "RAN_TRAPS": "ssh"
      },
      "expect": "warning",
      "message_contains": "smaller than RAN_ALERT_COOLDOWN"
    },
    {
      "id": "error-repeat-after-zero",
      "env": {
        "RAN_REPEAT_AFTER": "0",
        "RAN_TRAPS": "ssh"
      },
      "expect": "error",
      "message_contains": "RAN_REPEAT_AFTER"
    },
    {
      "id": "error-max-sessions-zero",
      "env": {
        "RAN_MAX_SESSIONS": "0",
        "RAN_TRAPS": "ssh"
      },
      "expect": "error",
      "message_contains": "RAN_MAX_SESSIONS"
    },
    {
      "id": "error-repeat-cooldown-zero",
      "env": {
        "RAN_REPEAT_COOLDOWN": "0s",
        "RAN_TRAPS": "ssh"
      },
      "expect": "error",
      "message_contains": "RAN_REPEAT_COOLDOWN"
    },
    {
      "id": "ok-bool-spellings",
      "env": {
        "RAN_CROWDSEC": "true",
        "RAN_CROWDSEC_MACHINE_ID": "ran",
        "RAN_CROWDSEC_PASSWORD": "x",
        "RAN_CROWDSEC_URL": "http://localhost:8080",
        "RAN_SHUN": "yes",
        "RAN_TRAPS": "ssh"
      },
      "expect": "ok"
    },
    {
      "id": "error-bool-invalid",
      "env": {
        "RAN_SSH_TARPIT": "maybe",
        "RAN_TRAPS": "ssh"
      },
      "expect": "error",
      "message_contains": "RAN_SSH_TARPIT"
    },
    {
      "id": "ok-proxy-protocol-true",
      "env": {
        "RAN_PROXY_PROTOCOL": "true",
        "RAN_PROXY_TRUSTED": "127.0.0.1",
        "RAN_TRAPS": "ssh"
      },
      "expect": "ok"
    },
    {
      "id": "error-proxy-trusted-any-uppercase",
      "env": {
        "RAN_PROXY_PROTOCOL": "on",
        "RAN_PROXY_TRUSTED": "ANY",
        "RAN_TRAPS": "ssh"
      },
      "expect": "error",
      "message_contains": "RAN_PROXY_TRUSTED"
    },
    {
      "id": "error-proxy-trusted-any-mixed",
      "env": {
        "RAN_PROXY_PROTOCOL": "on",
        "RAN_PROXY_TRUSTED": "any,127.0.0.1",
        "RAN_TRAPS": "ssh"
      },
      "expect": "error",
      "message_contains": "RAN_PROXY_TRUSTED"
    },
    {
      "id": "error-proxy-trusted-bad-cidr",
      "env": {
        "RAN_PROXY_PROTOCOL": "on",
        "RAN_PROXY_TRUSTED": "10.0.0.0/33",
        "RAN_TRAPS": "ssh"
      },
      "expect": "error",
      "message_contains": "RAN_PROXY_TRUSTED"
    },
    {
      "id": "error-ignore-ips-invalid",
      "env": {
        "RAN_IGNORE_IPS": "not-an-ip",
        "RAN_TRAPS": "ssh"
      },
      "expect": "error",
      "message_contains": "RAN_IGNORE_IPS"
    },
    {
      "id": "error-ignore-ips-zone",
      "env": {
        "RAN_IGNORE_IPS": "fe80::1%eth0",
        "RAN_TRAPS": "ssh"
      },
      "expect": "error",
      "message_contains": "RAN_IGNORE_IPS"
    },
    {
      "id": "error-ignore-ips-leading-zero",
      "env": {
        "RAN_IGNORE_IPS": "01.2.3.4",
        "RAN_TRAPS": "ssh"
      },
      "expect": "error",
      "message_contains": "RAN_IGNORE_IPS"
    },
    {
      "id": "ok-ignore-ips-mapped",
      "env": {
        "RAN_IGNORE_IPS": "::ffff:8.8.8.8,8.8.8.8/32",
        "RAN_TRAPS": "ssh"
      },
      "expect": "ok"
    },
